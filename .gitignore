
# Machine-generated git settings written by the ansible git role.
.config/git/config.local
.config/git/allowed_signers

# Written by lazy.nvim; machine-specific.
.config/nvim/lazy-lock.json

# Local python venv used to run molecule.
.venv/

# Machine-local shell environment: per-machine ids and endpoints, kept out of
# this public repo. Sourced by .zshenv along with the rest of .config/zsh.
.config/zsh/99-local.zsh

# Claude Code: track only the hooks. Everything else under ~/.claude is runtime
# state (credentials, session transcripts, caches, logs) or machine-local config
# (settings.json carries the Vertex project id) and must stay out of this repo.
.claude/*
!.claude/hooks/
