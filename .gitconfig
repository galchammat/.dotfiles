[user]
	email = alchammatg@gmail.com
	name = Ghazi Alchammat
	signingkey = ~/.ssh/id_ed25519
[gpg]
	format = ssh
[commit]
	gpgsign = True
[core]
	editor = nvim
[init]
	defaultBranch = main
[color]
	ui = auto
[diff]
	colorMoved = zebra
[fetch]
	prune = True
[rerere]
	enabled = True
[pull]
	ff = only
	rebase = True
[rebase]
	autoStash = True
[tag]
	gpgsign = True
[merge]
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[url "git@github.com:"]
	# Fetch over HTTPS, push over SSH.
	#
	# A new machine has no SSH key: it is generated by the ansible git role and
	# only reaches GitHub once `gh auth login` has run. So cloning and pulling
	# must work with no credentials, which HTTPS does for public repos.
	#
	# pushInsteadOf rewrites only the push URL, so pushes are authenticated
	# while fetches stay anonymous. Plain insteadOf would rewrite both and put
	# the chicken-and-egg problem straight back.
	pushInsteadOf = https://github.com/
