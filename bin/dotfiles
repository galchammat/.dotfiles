#!/bin/bash
# shellcheck shell=bash
# shellcheck disable=SC2034  # Unused variables are exported for child scripts

# Catppuccin Mocha color codes
NC='\033[0m'
BOLD='\033[1m'

# Catppuccin Mocha colors
CAT_ROSEWATER='\033[38;2;245;224;220m'
CAT_FLAMINGO='\033[38;2;242;205;205m'
CAT_PINK='\033[38;2;245;194;231m'
CAT_MAUVE='\033[38;2;203;166;247m'
CAT_RED='\033[38;2;243;139;168m'
CAT_MAROON='\033[38;2;235;160;172m'
CAT_PEACH='\033[38;2;250;179;135m'
CAT_YELLOW='\033[38;2;249;226;175m'
CAT_GREEN='\033[38;2;166;227;161m'
CAT_TEAL='\033[38;2;148;226;213m'
CAT_SKY='\033[38;2;137;220;235m'
CAT_SAPPHIRE='\033[38;2;116;199;236m'
CAT_BLUE='\033[38;2;137;180;250m'
CAT_LAVENDER='\033[38;2;180;190;254m'
CAT_TEXT='\033[38;2;205;214;244m'
CAT_SUBTEXT1='\033[38;2;186;194;222m'
CAT_SUBTEXT0='\033[38;2;166;173;200m'
CAT_OVERLAY2='\033[38;2;147;153;178m'
CAT_OVERLAY1='\033[38;2;127;132;156m'
CAT_OVERLAY0='\033[38;2;108;112;134m'
CAT_SURFACE2='\033[38;2;88;91;112m'
CAT_SURFACE1='\033[38;2;69;71;90m'
CAT_SURFACE0='\033[38;2;49;50;68m'
CAT_BASE='\033[38;2;30;30;46m'
CAT_MANTLE='\033[38;2;24;24;37m'
CAT_CRUST='\033[38;2;17;17;27m'

# Legacy mappings for easier use
RED="$CAT_RED"
GREEN="$CAT_GREEN"
YELLOW="$CAT_YELLOW"
BLUE="$CAT_BLUE"
PURPLE="$CAT_MAUVE"
CYAN="$CAT_TEAL"
WHITE="$CAT_TEXT"
ORANGE="$CAT_PEACH"
LBLACK="$CAT_SURFACE0"
LRED="$CAT_RED"
LGREEN="$CAT_GREEN"
LYELLOW="$CAT_YELLOW"
LBLUE="$CAT_BLUE"
LPURPLE="$CAT_MAUVE"
LCYAN="$CAT_TEAL"

# Special
SEA="$CAT_SAPPHIRE"
OVERWRITE='\e[1A\e[K'

#emoji codes
CHECK_MARK="${GREEN}\xE2\x9C\x94${NC}"
X_MARK="${RED}\xE2\x9C\x96${NC}"
PIN="${RED}\xF0\x9F\x93\x8C${NC}"
CLOCK="${GREEN}\xE2\x8C\x9B${NC}"
ARROW="${SEA}\xE2\x96\xB6${NC}"
BOOK="${RED}\xF0\x9F\x93\x8B${NC}"
HOT="${ORANGE}\xF0\x9F\x94\xA5${NC}"
WARNING="${RED}\xF0\x9F\x9A\xA8${NC}"
RIGHT_ANGLE="${GREEN}\xE2\x88\x9F${NC}"



set -e

# tput drives the spinner and cursor control. It comes from ncurses, which a
# minimal install may not ship. It is purely cosmetic, so rather than refusing
# to run, fall back to a no-op and carry on: an installer should not die over
# progress animation. The OS setup below installs ncurses where it can.
if ! command -v tput &> /dev/null; then
  tput() { :; }
fi

# Early check for help/version flags (before setup)
for arg in "$@"; do
  case $arg in
    -h|--help)
      SHOW_HELP=true
      ;;
    --version)
      SHOW_VERSION=true
      ;;
    --clone-only)
      # Fetch/update the repository and exit without installing packages or
      # running ansible. Used by the molecule bootstrap scenario to regression
      # test the clone on a machine that has no credentials of any kind.
      CLONE_ONLY=true
      ;;
  esac
done

# Cleanup function for exit
cleanup() {
  # Kill spinner if running
  if [[ $SPINNER_PID != "" ]]; then
    kill $SPINNER_PID 2>/dev/null
    wait $SPINNER_PID 2>/dev/null
  fi
  # Show cursor
  tput cnorm
}

# Set trap to cleanup on exit
trap cleanup EXIT INT TERM

# Paths
DOTFILES_LOG="${TMPDIR:-/tmp}/.dotfiles.log.$$"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
DOTFILES_ANSIBLE="$DOTFILES_DIR/ansible"
IS_FIRST_RUN="$HOME/.dotfiles_run"
DOTFILES_VERSION="2.0.0"

# The repository is cloned over HTTPS. It is public, so this works on a
# factory-fresh machine with no credentials at all. Cloning over SSH cannot
# work here: the SSH key is generated and uploaded to GitHub by the ansible
# git role, which necessarily runs *after* this clone. Once that role has run,
# the remote is upgraded to SSH so pushes are authenticated.
DOTFILES_REPO_HTTPS="https://github.com/galchammat/.dotfiles.git"
DOTFILES_REPO_SSH="git@github.com:galchammat/.dotfiles.git"
# Branch to install from. Override to bootstrap from a feature branch:
#   DOTFILES_BRANCH=feat/stow-migration bash -c "$(curl -fsSL .../bin/dotfiles)"
DOTFILES_BRANCH="${DOTFILES_BRANCH:-main}"

# Pre-stow layout: a bare repo checked out directly over $HOME.
DOTFILES_LEGACY_GIT="$HOME/.dotfiles.git"
# Spinner PID tracking
SPINNER_PID=""

# Show usage/help information
show_help() {
  echo -e "${CAT_SAPPHIRE}galchammat Dotfiles${NC}"
  echo ""
  echo -e "${CAT_BLUE}USAGE:${NC}"
  echo "    dotfiles [OPTIONS] [-- ANSIBLE_ARGS]"
  echo ""
  echo -e "${CAT_BLUE}OPTIONS:${NC}"
  echo -e "    ${CAT_GREEN}-h, --help${NC}              Show this help message"
  echo -e "    ${CAT_GREEN}--version${NC}               Show version information"
  echo -e "    ${CAT_GREEN}--uninstall <role>${NC}      Uninstall a role (cleanup only)"
  echo -e "    ${CAT_GREEN}--delete <role>${NC}         Uninstall and delete a role from dotfiles"
  echo -e "    ${CAT_GREEN}--clone-only${NC}            Clone/update the repo only, skip packages and ansible"
  echo -e "    ${CAT_GREEN}-v, -vv, -vvv${NC}           Verbose mode (passed to ansible-playbook)"
  echo ""
  echo -e "${CAT_BLUE}EXAMPLES:${NC}"
  echo -e "    ${CAT_SUBTEXT1}# Run full dotfiles installation${NC}"
  echo "    dotfiles"
  echo ""
  echo -e "    ${CAT_SUBTEXT1}# Install specific roles only${NC}"
  echo "    dotfiles -t neovim,git,tmux"
  echo ""
  echo -e "    ${CAT_SUBTEXT1}# Dry run (test without applying)${NC}"
  echo "    dotfiles --check"
  echo ""
  echo -e "    ${CAT_SUBTEXT1}# Uninstall a role${NC}"
  echo "    dotfiles --uninstall neovim"
  echo ""
  echo -e "    ${CAT_SUBTEXT1}# Delete a role completely${NC}"
  echo "    dotfiles --delete old_role"
  echo ""
  echo -e "${CAT_BLUE}ANSIBLE ARGUMENTS:${NC}"
  echo "    All arguments not recognized by dotfiles are passed to ansible-playbook."
  echo "    Common options: -t <tags>, --check, -vvv, --list-tags"
  echo ""
  echo -e "${CAT_SUBTEXT0}For more information: https://github.com/galchammat/.dotfiles${NC}"
}

# Show version information
show_version() {
  local git_hash=""
  if [[ -d "$DOTFILES_DIR/.git" ]]; then
    git_hash=$(git -C "$DOTFILES_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
  fi
  echo -e "${CAT_SAPPHIRE}galchammat Dotfiles${NC} version ${CAT_GREEN}${DOTFILES_VERSION}${NC} (${CAT_SUBTEXT1}${git_hash}${NC})"
}

# Spinner function that runs in background
_spinner() {
  local task_text="$1"
  local chars=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local delay=0.08

  # Hide cursor
  tput civis

  # Save cursor position
  tput sc

  while true; do
    for char in "${chars[@]}"; do
      # Restore cursor position and clear line
      tput rc
      tput el
      printf "${CAT_OVERLAY1} [${CAT_SAPPHIRE}${char}${CAT_OVERLAY1}]  ${CAT_TEXT}${task_text}" >&2
      sleep $delay
    done
  done
}

# Start a new task with spinner
__task() {
  # if a task is running, complete it first
  if [[ $TASK != "" ]] && [[ $SPINNER_PID != "" ]]; then
    _task_done
  fi

  # set new task
  TASK=$1

  # Start spinner in background
  _spinner "$TASK" &
  SPINNER_PID=$!

  # Disable job control messages
  disown $SPINNER_PID 2>/dev/null
}

# _cmd performs commands with error checking
_cmd() {
  #create log if it doesn't exist
  if ! [[ -f $DOTFILES_LOG ]]; then
    touch $DOTFILES_LOG
  fi
  # empty conduro.log
  > $DOTFILES_LOG

  # hide stdout, on error we print and exit
  if eval "$1" 1> /dev/null 2> $DOTFILES_LOG; then
    return 0 # success
  else
    # Kill spinner if running
    if [[ $SPINNER_PID != "" ]]; then
      kill $SPINNER_PID 2>/dev/null
      wait $SPINNER_PID 2>/dev/null
      SPINNER_PID=""
    fi

    # Show cursor again
    tput cnorm

    # Clear the line and show error
    printf "\r\033[K${CAT_RED} [✗]  ${CAT_TEXT}${TASK}${NC}\n"

    # Show error details
    local line
    while read -r line; do
      printf "      ${CAT_MAROON}%s${NC}\n" "$line"
    done < "$DOTFILES_LOG"
    printf "\n"

    # remove log file
    rm $DOTFILES_LOG
    # exit installation
    exit 1
  fi
}

_clear_task() {
  TASK=""
}

_task_done() {
  # Kill spinner if running
  if [[ $SPINNER_PID != "" ]]; then
    kill $SPINNER_PID 2>/dev/null
    wait $SPINNER_PID 2>/dev/null
    SPINNER_PID=""
  fi

  # Show cursor again
  tput cnorm

  # Clear line and show success
  printf "\r\033[K${CAT_GREEN} [✓]  ${CAT_TEXT}${TASK}\n"
  _clear_task
}

ubuntu_setup() {
  # Source os-release to get VERSION_ID
  if [ -f /etc/os-release ]; then
    source /etc/os-release
  fi

  # ncurses-bin provides tput, needed by the spinner before ansible runs.
  if ! [ -x "$(command -v tput)" ]; then
    _cmd "sudo apt update"
    _cmd "sudo apt install -y ncurses-bin"
    unset -f tput 2>/dev/null || true
  fi

  # git is needed to clone this repo a few lines below, so it cannot wait for
  # the packages role.
  if ! [ -x "$(command -v git)" ]; then
    __task "Installing Git"
    _cmd "sudo apt update"
    _cmd "sudo apt install -y git"
  fi

  if ! dpkg -s ansible >/dev/null 2>&1; then
    __task "Installing Ansible (This may take a few minutes)"
    _cmd "sudo apt update"
    _cmd "sudo apt upgrade -y"
    _cmd "sudo apt install -y ansible"
    _cmd "sudo apt install -y python3-argcomplete"
  fi
  if ! dpkg -s python3 >/dev/null 2>&1; then
    __task "Installing Python3"
    _cmd "sudo apt install -y python3"
  fi

  local UBUNTU_MAJOR_VERSION=$(echo "$VERSION_ID" | cut -d. -f1)
  if [ "$UBUNTU_MAJOR_VERSION" -le 22 ] 2>/dev/null; then
    if ! dpkg -s python3-pip >/dev/null 2>&1; then
      __task "Installing Python3 Pip"
      _cmd "sudo apt install -y python3-pip"
    fi
    if ! pip3 list | grep watchdog >/dev/null 2>&1; then
      __task "Installing Python3 Watchdog"
      _cmd "sudo apt install -y python3-watchdog"
    fi
  fi
}

arch_setup() {
  # ncurses provides tput, needed by the spinner before ansible runs.
  if ! [ -x "$(command -v tput)" ]; then
    _cmd "sudo pacman -Sy --noconfirm"
    _cmd "sudo pacman -S --noconfirm ncurses"
    unset -f tput 2>/dev/null || true
  fi
  # git is needed to clone this repo a few lines below, so it cannot wait for
  # the packages role.
  if ! [ -x "$(command -v git)" ]; then
    __task "Installing Git"
    _cmd "sudo pacman -Sy --noconfirm"
    _cmd "sudo pacman -S --noconfirm git"
  fi
  if ! [ -x "$(command -v ansible)" ]; then
    __task "Installing Ansible (This may take a few minutes)"
    _cmd "sudo pacman -Sy --noconfirm"
    _cmd "sudo pacman -S --noconfirm ansible"
    _cmd "sudo pacman -S --noconfirm python-argcomplete"
    # _cmd "sudo activate-global-python-argcomplete3"
  fi
  if ! pacman -Q python3 >/dev/null 2>&1; then
    __task "Installing Python3"
    _cmd "sudo pacman -S --noconfirm python3"
  fi
  if ! pacman -Q python-pip >/dev/null 2>&1; then
    __task "Installing Python3 Pip"
    _cmd "sudo pacman -S --noconfirm python-pip"
  fi
  if ! pip3 list | grep watchdog >/dev/null 2>&1; then
    __task "Installing Python3 Watchdog"
    _cmd "sudo pacman -S --noconfirm python-watchdog"
  fi

  if ! pacman -Q openssh >/dev/null 2>&1; then
    __task "Installing OpenSSH"
    _cmd "sudo pacman -S --noconfirm openssh"
  fi

  __task "Setting Locale"
  _cmd "sudo localectl set-locale LANG=en_US.UTF-8"
}

fedora_setup() {
  # ncurses provides tput, which the spinner uses. Installed here rather than in
  # the packages role because the script needs it before ansible ever runs.
  if ! [ -x "$(command -v tput)" ]; then
    _cmd "sudo dnf install -y ncurses"
    unset -f tput 2>/dev/null || true
  fi
  # git is needed to clone this repo a few lines below, so it cannot wait for
  # the packages role.
  if ! [ -x "$(command -v git)" ]; then
    __task "Installing Git"
    _cmd "sudo dnf install -y git"
  fi
  if ! [ -x "$(command -v ansible)" ]; then
    __task "Installing Ansible (This may take a few minutes)"
    _cmd "sudo dnf install -y ansible"
  fi
  if ! [ -x "$(command -v python3)" ]; then
    __task "Installing Python3"
    _cmd "sudo dnf install -y python3"
  fi
  if ! [ -x "$(command -v pip3)" ]; then
    __task "Installing Python3 Pip"
    _cmd "sudo dnf install -y python3-pip"
  fi
  if ! rpm -q python3-argcomplete >/dev/null 2>&1; then
    __task "Installing Python3 Argcomplete"
    _cmd "sudo dnf install -y python3-argcomplete"
    _cmd "sudo activate-global-python-argcomplete3 || true"
  fi
  if ! pip3 list | grep watchdog >/dev/null 2>&1; then
    __task "Installing Python3 Watchdog"
    _cmd "pip3 install --user watchdog"
  fi
}

macos_setup() {
  if ! [ -x "$(command -v brew)" ]; then
    __task "Installing Homebrew (This may take 5-10 minutes)"
    _cmd "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
  fi
  if ! [ -x "$(command -v git)" ]; then
    __task "Installing Git"
    _cmd "brew install git"
  fi
  if ! [ -x "$(command -v ansible)" ]; then
    __task "Installing Ansible"
    _cmd "brew install ansible"
  fi
}



detect_os() {
  if [ -f /etc/os-release ]; then
    source /etc/os-release
    echo $ID
  else
    echo $(uname -s | tr '[:upper:]' '[:lower:]')
  fi
}

print_banner() {
  echo ""
  echo -e "${CAT_SAPPHIRE}   ██████╗  █████╗ ██╗      ██████╗██╗  ██╗ █████╗ ███╗   ███╗███╗   ███╗ █████╗ ████████╗${NC}"
  echo -e "${CAT_SAPPHIRE}  ██╔════╝ ██╔══██╗██║     ██╔════╝██║  ██║██╔══██╗████╗ ████║████╗ ████║██╔══██╗╚══██╔══╝${NC}"
  echo -e "${CAT_SAPPHIRE}  ██║  ███╗███████║██║     ██║     ███████║███████║██╔████╔██║██╔████╔██║███████║   ██║   ${NC}"
  echo -e "${CAT_SAPPHIRE}  ██║   ██║██╔══██║██║     ██║     ██╔══██║██╔══██║██║╚██╔╝██║██║╚██╔╝██║██╔══██║   ██║   ${NC}"
  echo -e "${CAT_SAPPHIRE}  ╚██████╔╝██║  ██║███████╗╚██████╗██║  ██║██║  ██║██║ ╚═╝ ██║██║ ╚═╝ ██║██║  ██║   ██║   ${NC}"
  echo -e "${CAT_SAPPHIRE}   ╚═════╝ ╚═╝  ╚═╝╚══════╝ ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝   ╚═╝   ${NC}"
  echo ""
  echo -e "${CAT_BLUE}      ██████╗  ██████╗ ████████╗███████╗██╗██╗     ███████╗███████╗${NC}"
  echo -e "${CAT_BLUE}      ██╔══██╗██╔═══██╗╚══██╔══╝██╔════╝██║██║     ██╔════╝██╔════╝${NC}"
  echo -e "${CAT_BLUE}      ██║  ██║██║   ██║   ██║   █████╗  ██║██║     █████╗  ███████╗${NC}"
  echo -e "${CAT_BLUE}      ██║  ██║██║   ██║   ██║   ██╔══╝  ██║██║     ██╔══╝  ╚════██║${NC}"
  echo -e "${CAT_BLUE}      ██████╔╝╚██████╔╝   ██║   ██║     ██║███████╗███████╗███████║${NC}"
  echo -e "${CAT_BLUE}      ╚═════╝  ╚═════╝    ╚═╝   ╚═╝     ╚═╝╚══════╝╚══════╝╚══════╝${NC}"
  echo ""
}

# Handle early exit for help/version (before banner and setup)
if [[ "${SHOW_HELP:-}" == "true" ]]; then
  show_help
  exit 0
fi

if [[ "${SHOW_VERSION:-}" == "true" ]]; then
  show_version
  exit 0
fi

print_banner

dotfiles_os=$(detect_os)
if [[ "${CLONE_ONLY:-}" != "true" ]]; then
  __task "Loading Setup for detected OS: $dotfiles_os"
  case $dotfiles_os in
    ubuntu)
      ubuntu_setup
      ;;
    pop)
      ubuntu_setup
      ;;
    arch)
      arch_setup
      ;;
    fedora)
      fedora_setup
      ;;
    darwin)
      macos_setup
      ;;
    *)
      __task "Unsupported OS"
      _cmd "echo 'Unsupported OS'"
      ;;
  esac
fi

if ! [[ -d "$DOTFILES_DIR/.git" ]]; then
  __task "Downloading dotfiles repository (This may take a minute)"
  _cmd "git clone --quiet --branch '$DOTFILES_BRANCH' '$DOTFILES_REPO_HTTPS' '$DOTFILES_DIR'"
  _task_done
else
  __task "Updating dotfiles repository"
  _cmd "git -C '$DOTFILES_DIR' pull --quiet --ff-only"
  _task_done
fi

if [[ "${CLONE_ONLY:-}" == "true" ]]; then
  echo -e "${CHECK_MARK} ${CAT_GREEN}Repository ready at ${DOTFILES_DIR}${NC}"
  exit 0
fi

# Warn about the pre-stow bare repository. It is inert once this script stops
# invoking it, but leaving it in place is confusing and it still holds the
# only copy of any commits that were never pushed.
if [[ -d "$DOTFILES_LEGACY_GIT" ]]; then
  echo -e "${WARNING} ${CAT_YELLOW}Found the old bare dotfiles repo at ${BOLD}${DOTFILES_LEGACY_GIT}${NC}"
  echo -e "      ${CAT_SUBTEXT1}The dotfiles now live at ${DOTFILES_DIR} and are linked with stow.${NC}"
  echo -e "      ${CAT_SUBTEXT1}Any real files it left in \$HOME are backed up to ~/.dotfiles-backup${NC}"
  echo -e "      ${CAT_SUBTEXT1}before they are replaced by symlinks.${NC}"
  echo ""
  echo -e "      ${CAT_SUBTEXT1}Check for unpushed work, then remove it:${NC}"
  echo -e "      ${CAT_TEAL}git --git-dir=$DOTFILES_LEGACY_GIT --work-tree=\$HOME log --branches --not --remotes${NC}"
  echo -e "      ${CAT_TEAL}rm -rf $DOTFILES_LEGACY_GIT${NC}"
  echo ""
fi

# Parse arguments for uninstall/delete
UNINSTALL_ROLE=""
DELETE_ROLE=""
REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      show_help
      exit 0
      ;;
    --version)
      show_version
      exit 0
      ;;
    --uninstall)
      if [[ -z "$2" || "$2" == -* ]]; then
        echo -e "${RED} [✗]  ${CAT_TEXT}Error: --uninstall requires a role name${NC}"
        exit 1
      fi
      UNINSTALL_ROLE="$2"
      shift 2
      ;;
    --delete)
      if [[ -z "$2" || "$2" == -* ]]; then
        echo -e "${RED} [✗]  ${CAT_TEXT}Error: --delete requires a role name${NC}"
        exit 1
      fi
      DELETE_ROLE="$2"
      shift 2
      ;;
    *)
      REMAINING_ARGS+=("$1")
      shift
      ;;
  esac
done

# Common function to run uninstall script
run_uninstall_script() {
  local role="$1"
  local role_dir="$DOTFILES_ANSIBLE/roles/$role"
  local uninstall_script="$role_dir/uninstall.sh"

  if [[ ! -d "$role_dir" ]]; then
    echo -e "${RED} [✗]  ${CAT_TEXT}Error: Role '${role}' not found${NC}"
    return 1
  fi

  if [[ ! -f "$uninstall_script" ]]; then
    echo -e "${RED} [✗]  ${CAT_TEXT}Error: Role '${role}' does not have an uninstall script${NC}"
    return 1
  fi

  # Export functions and colors for use in uninstall script
  export -f __task _task_done _clear_task _cmd _spinner
  export SPINNER_PID TASK DOTFILES_LOG
  export NC BOLD
  export CAT_ROSEWATER CAT_FLAMINGO CAT_PINK CAT_MAUVE CAT_RED CAT_MAROON
  export CAT_PEACH CAT_YELLOW CAT_GREEN CAT_TEAL CAT_SKY CAT_SAPPHIRE
  export CAT_BLUE CAT_LAVENDER CAT_TEXT CAT_SUBTEXT1 CAT_SUBTEXT0
  export CAT_OVERLAY2 CAT_OVERLAY1 CAT_OVERLAY0 CAT_SURFACE2 CAT_SURFACE1
  export CAT_SURFACE0 CAT_BASE CAT_MANTLE CAT_CRUST
  export RED GREEN YELLOW BLUE PURPLE CYAN WHITE LBLACK
  export LRED LGREEN LYELLOW LBLUE LPURPLE LCYAN SEA OVERWRITE
  export CHECK_MARK X_MARK PIN CLOCK ARROW BOOK HOT WARNING RIGHT_ANGLE

  # Run uninstall script with exported environment
  bash "$uninstall_script"
  return 0
}

# Handle uninstall (cleanup only)
if [[ -n "$UNINSTALL_ROLE" ]]; then
  # Confirm uninstall
  echo -e "${YELLOW} [?]  ${CAT_TEXT}This will uninstall ${BOLD}${CAT_MAUVE}${UNINSTALL_ROLE}${NC}."
  read -p "$(echo -e "${YELLOW}Are you sure? (y/N) ${NC}")" -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    if run_uninstall_script "$UNINSTALL_ROLE"; then
      echo -e "${GREEN} [✓]  ${CAT_TEXT}${UNINSTALL_ROLE} has been uninstalled${NC}"
    else
      exit 1
    fi
  else
    echo -e "${YELLOW} [!]  ${CAT_TEXT}Uninstall cancelled${NC}"
  fi
  exit 0
fi

# Handle delete (uninstall + remove role)
if [[ -n "$DELETE_ROLE" ]]; then
  ROLE_DIR="$DOTFILES_ANSIBLE/roles/$DELETE_ROLE"
  UNINSTALL_SCRIPT="$ROLE_DIR/uninstall.sh"

  # Check if role exists
  if [[ ! -d "$ROLE_DIR" ]]; then
    echo -e "${RED} [✗]  ${CAT_TEXT}Error: Role '${DELETE_ROLE}' not found${NC}"
    exit 1
  fi

  # Confirm delete
  if [[ -f "$UNINSTALL_SCRIPT" ]]; then
    echo -e "${YELLOW} [?]  ${CAT_TEXT}This will uninstall ${BOLD}${CAT_MAUVE}${DELETE_ROLE}${NC} and ${BOLD}${CAT_RED}DELETE${NC} the role from your dotfiles."
  else
    echo -e "${YELLOW} [?]  ${CAT_TEXT}This will ${BOLD}${CAT_RED}DELETE${NC} the role ${BOLD}${CAT_MAUVE}${DELETE_ROLE}${NC} from your dotfiles."
    echo -e "${YELLOW}      ${CAT_TEXT}Note: No uninstall script exists, so only the role directory will be removed.${NC}"
  fi

  read -p "$(echo -e "${YELLOW}Are you sure? (y/N) ${NC}")" -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    # Run uninstall script if it exists
    if [[ -f "$UNINSTALL_SCRIPT" ]]; then
      if ! run_uninstall_script "$DELETE_ROLE"; then
        echo -e "${YELLOW} [!]  ${CAT_TEXT}Uninstall script failed, but continuing with deletion...${NC}"
      fi
    fi

    # Remove from group_vars/all.yml (with backup)
    if grep -q "^  - $DELETE_ROLE$" "$DOTFILES_ANSIBLE/group_vars/all.yml"; then
      __task "Removing $DELETE_ROLE from configuration"
      cp "$DOTFILES_ANSIBLE/group_vars/all.yml" "$DOTFILES_ANSIBLE/group_vars/all.yml.bak"
      # Use portable sed -i syntax (macOS requires '', Linux doesn't)
      if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "/^  - $DELETE_ROLE$/d" "$DOTFILES_ANSIBLE/group_vars/all.yml"
      else
        sed -i "/^  - $DELETE_ROLE$/d" "$DOTFILES_ANSIBLE/group_vars/all.yml"
      fi
      _task_done
    fi

    # Remove role directory
    __task "Removing $DELETE_ROLE role directory"
    rm -rf "$ROLE_DIR"
    _task_done

    if [[ -f "$UNINSTALL_SCRIPT" ]]; then
      echo -e "${GREEN} [✓]  ${CAT_TEXT}${DELETE_ROLE} has been uninstalled and deleted${NC}"
    else
      echo -e "${GREEN} [✓]  ${CAT_TEXT}${DELETE_ROLE} has been deleted${NC}"
    fi
  else
    echo -e "${YELLOW} [!]  ${CAT_TEXT}Delete cancelled${NC}"
  fi
  exit 0
fi

_task_done
ansible-playbook "$DOTFILES_ANSIBLE/playbook.yml" \
  -i "$DOTFILES_ANSIBLE/hosts" \
  --ask-become-pass \
  "${REMAINING_ARGS[@]}"

# Steps that need a human are collected by the roles rather than run inline, so
# the playbook never blocks. Print them last, where they will not scroll away.
NEXT_STEPS="$HOME/.dotfiles-next-steps"
if [[ -s "$NEXT_STEPS" ]]; then
  echo ""
  echo -e "${BOOK} ${CAT_YELLOW}Finish setup by running:${NC}"
  echo ""
  while IFS= read -r step; do
    [[ -z "$step" ]] && continue
    echo -e "    ${CAT_TEAL}${step}${NC}"
  done < "$NEXT_STEPS"
  echo ""
  echo -e "      ${CAT_SUBTEXT1}These need a browser or your input, so they are not automated.${NC}"
  echo -e "      ${CAT_SUBTEXT1}Re-run ${CAT_TEAL}dotfiles${CAT_SUBTEXT1} afterwards to finish anything that depended on them.${NC}"
  echo ""
fi

# The git role has now generated an SSH key and uploaded it to GitHub, so the
# remote can be upgraded from HTTPS to SSH for authenticated pushes.
if git -C "$DOTFILES_DIR" remote get-url origin 2>/dev/null | grep -q '^https://'; then
  # ssh -T against GitHub exits non-zero even on success, so match the banner.
  if ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 \
      | grep -q 'successfully authenticated'; then
    __task "Switching dotfiles remote to SSH"
    _cmd "git -C '$DOTFILES_DIR' remote set-url origin '$DOTFILES_REPO_SSH'"
    _task_done
  fi
fi

if ! [[ -f "$IS_FIRST_RUN" ]]; then
  echo ""
  echo -e "${CHECK_MARK} ${CAT_GREEN}🎉 Dotfiles installation complete!${NC}"
  echo -e "${ARROW} ${CAT_TEAL}Please reboot your computer to complete the setup.${NC}"
  echo ""
  touch "$IS_FIRST_RUN"
fi

# vi:ft=sh:
