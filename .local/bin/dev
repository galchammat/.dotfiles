#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   dev            -> uses current directory
#   dev .          -> uses current directory
#   dev path/to/dir -> uses that directory

DIR="${1:-.}"
DIR="$(realpath -m "$DIR")"

if [[ ! -d "$DIR" ]]; then
  echo "dev: not a directory: $DIR" >&2
  exit 2
fi

# Session name derived from directory name (safe chars only)
NAME="$(basename "$DIR")"
NAME="${NAME//[^A-Za-z0-9_-]/_}"
SESSION="${NAME}"

# If session exists, just switch/attach to it
if tmux has-session -t "$SESSION" 2>/dev/null; then
  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$SESSION"
  else
    exec tmux attach -t "$SESSION"
  fi
fi

# Preferred coding agent for window 1. This script is constant: the choice lives
# in AI_AGENT, exported from ~/.config/zsh/99-local.zsh and set via
# `dotfiles --agent <copilot|claude|codex|opencode>`. Falls back to claude when
# unset (e.g. launched from a shell that never sourced the zsh config), and to a
# plain shell (with a hint) if the configured agent isn't installed, so a new
# session never dies on startup.
AGENT="${AI_AGENT:-claude}"

# Create session with windows starting in DIR:
#   window 1: the preferred coding agent
#   window 2: a plain shell
# Window 2 passes no command, so tmux uses its configured default-command, which
# .tmux.conf already sets to zsh (falling back to tmux's default where absent) —
# no need to hardcode the shell here.
if command -v "$AGENT" >/dev/null 2>&1; then
  tmux new-session -d -s "$SESSION" -n "$AGENT" -c "$DIR" "$AGENT"
else
  # Agent not installed: land in a normal shell with a hint instead of failing.
  tmux new-session -d -s "$SESSION" -n "$AGENT" -c "$DIR" \
    "printf '%s\n' \"dev: agent '$AGENT' not found on PATH. Set/install one with: dotfiles --agent <copilot|claude|codex|opencode>\"; exec \"\${SHELL:-sh}\""
fi
tmux new-window -t "$SESSION:2" -n zsh -c "$DIR"

# Focus the agent window by default
tmux select-window -t "$SESSION:1"

# Enter it (switch if already inside tmux to avoid nesting)
if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "$SESSION"
else
  exec tmux attach -t "$SESSION"
fi

