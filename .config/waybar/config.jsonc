// Stock waybar config with Hyprland modules. Module formatting comes from the
// distro default; this file only sets the layout and the on-demand HUD behavior.
{
    "include": ["/etc/xdg/waybar/config.jsonc"],

    // Drawn over windows without reserving space, so nothing reflows when it
    // appears. Shown/hidden by the ALT-hold logic in .config/hypr/hyprland.lua.
    "layer": "overlay",
    "position": "top",
    "exclusive": false,
    "start_hidden": true,
    "on-sigusr1": "show",
    "on-sigusr2": "hide",

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "backlight",
        "battery",
        "clock",
        "tray"
    ]
}
